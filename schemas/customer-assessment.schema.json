{
  "type": "object",
  "properties": {
    "context": {
      "type": "object",
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "assessment_version": {
          "type": "integer",
          "minimum": 1
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "supersedes_snapshot_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "organization_id",
        "case_id",
        "assessment_version",
        "as_of"
      ],
      "additionalProperties": false
    },
    "company_profile": {
      "type": "object",
      "properties": {
        "registration_number": {
          "type": "string",
          "minLength": 1
        },
        "legal_status": {
          "type": "string",
          "minLength": 1
        },
        "operating_locations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "business_activities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "licences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "licence_id": {
                "type": "string",
                "minLength": 1
              },
              "issuer": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "Unknown",
                  "Valid",
                  "Expired",
                  "Revoked"
                ]
              },
              "valid_until": {
                "type": "string",
                "format": "date"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "licence_id",
              "issuer",
              "status",
              "evidence_refs"
            ],
            "additionalProperties": false
          }
        },
        "relationship_purpose": {
          "type": "string",
          "minLength": 1
        },
        "expected_activity": {
          "type": "string",
          "minLength": 1
        },
        "wealth_source": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "party_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relationship_id": {
            "type": "string",
            "minLength": 1
          },
          "from_party_id": {
            "type": "string",
            "minLength": 1
          },
          "to_party_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship_type": {
            "enum": [
              "ownership",
              "control",
              "representation"
            ]
          },
          "shareholding_percentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "voting_percentage": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "control_basis": {
            "type": "string",
            "minLength": 1
          },
          "authority_scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_to": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "relationship_id",
          "from_party_id",
          "to_party_id",
          "relationship_type",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "relationship_type": {
                  "const": "ownership"
                }
              }
            },
            "then": {
              "required": [
                "shareholding_percentage"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "relationship_type": {
                  "const": "control"
                }
              }
            },
            "then": {
              "required": [
                "control_basis"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "relationship_type": {
                  "const": "representation"
                }
              }
            },
            "then": {
              "required": [
                "authority_scope",
                "valid_from",
                "valid_to"
              ]
            }
          }
        ]
      }
    },
    "screening_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "party_id": {
            "type": "string",
            "minLength": 1
          },
          "screening_type": {
            "enum": [
              "Sanctions",
              "PEP",
              "AdverseMedia"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "party_id",
          "screening_type",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "screening_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "screening_id": {
            "type": "string",
            "minLength": 1
          },
          "party_id": {
            "type": "string",
            "minLength": 1
          },
          "screening_type": {
            "enum": [
              "Sanctions",
              "PEP",
              "AdverseMedia"
            ]
          },
          "execution_status": {
            "enum": [
              "NotRun",
              "Failed",
              "Completed"
            ]
          },
          "screened_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_system": {
            "type": "string",
            "minLength": 1
          },
          "watchlist_id": {
            "type": "string",
            "minLength": 1
          },
          "list_version": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidate_id": {
                  "type": "string",
                  "minLength": 1
                },
                "disposition": {
                  "enum": [
                    "Pending",
                    "FalsePositive",
                    "Confirmed"
                  ]
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "candidate_id",
                "disposition"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "disposition": {
                        "enum": [
                          "FalsePositive",
                          "Confirmed"
                        ]
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "reviewer",
                      "reviewed_at",
                      "evidence_refs"
                    ]
                  }
                }
              ]
            }
          },
          "error": {
            "type": "string",
            "minLength": 1
          },
          "attempted_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date"
          },
          "policy_review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer",
              "reviewed_at",
              "policy_version",
              "factor_ids",
              "evidence_refs"
            ],
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "policy_version": {
                "type": "string",
                "minLength": 1
              },
              "factor_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^RF-(0[1-9]|1[0-9]|2[01])$"
                }
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "required": [
          "screening_id",
          "party_id",
          "screening_type",
          "execution_status",
          "source_system",
          "candidates",
          "attempted_at"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "execution_status": {
                  "const": "Completed"
                }
              }
            },
            "then": {
              "required": [
                "screened_at",
                "watchlist_id",
                "list_version",
                "evidence_refs"
              ]
            }
          }
        ]
      }
    },
    "evidence_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "object_uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "verification_status": {
            "enum": [
              "Received",
              "Verified",
              "Rejected",
              "Conflicted"
            ]
          },
          "verified_by": {
            "type": "string",
            "minLength": 1
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": "string",
            "format": "date"
          },
          "conflicts_with": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "evidence_id",
          "artifact_id",
          "object_uri",
          "sha256",
          "version",
          "locator",
          "verification_status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "verification_status": {
                  "const": "Verified"
                }
              }
            },
            "then": {
              "required": [
                "verified_by",
                "verified_at"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "funding_background": {
      "type": "object",
      "properties": {
        "assessment_basis": {
          "const": "CustomerBackground"
        },
        "source_events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "source_type": {
                "type": "string",
                "minLength": 1
              },
              "owner_party_id": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "event_date": {
                "type": "string",
                "format": "date"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "event_id",
              "source_type",
              "owner_party_id",
              "amount",
              "currency",
              "event_date",
              "evidence_refs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "assessment_basis",
        "source_events"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "context",
    "party_relationships",
    "screening_requirements",
    "screening_runs",
    "evidence_records"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fyp:customer-assessment:1",
  "title": "data.CustomerAssessment — customer AML only"
}
